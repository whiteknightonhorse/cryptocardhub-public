{
  "platform": "instagram",
  "cover_frame_seconds": 1.0,
  "cover_overlay": {
    "ftc_burn_in_window_sec": [0.0, 6.0],
    "hook_overlay_window_sec": [0.0, 3.0],
    "hook_text": {"font": "Anton-Regular.ttf", "size": 96, "fill": "#FFD700", "stroke": "#000000", "stroke_px": 6, "y_pct": 35}
  },
  "captions": {
    "font": "Anton-Regular.ttf",
    "size_range": [70, 90],
    "fill": "#FFFFFF",
    "stroke": "#000000",
    "stroke_px": 6,
    "y_pct": 75,
    "highlight_fill": "#F7C204",
    "highlight_keywords_regex": "^(\\d+%?|\\$[\\d.]+[MmKkBb]?|YES|NO|NEVER|ALWAYS|NEWS|BREAKING|SHOCK|CRASH|SPIKE|BOOM|NEW|FIRST|LAST|ONLY|EVERY|NOBODY|EVERYONE|FREE|EARN|YIELD|CASHBACK|TAP)$"
  }
}
