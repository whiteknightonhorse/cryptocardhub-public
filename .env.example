# =============================================================================
# DefyCard — Environment template
# Copy to `.env` and fill real values. NEVER commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Video Generator — content sources
# -----------------------------------------------------------------------------
PEXELS_API_KEY=
JAMENDO_CLIENT_ID=

# -----------------------------------------------------------------------------
# Video Generator — YouTube Data API v3 (OAuth refresh-token flow)
# -----------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# -----------------------------------------------------------------------------
# Video Generator — dlvr.it (Instagram + TikTok routing)
# -----------------------------------------------------------------------------
DLVRIT_API_KEY=
DLVRIT_ROUTE_IG=
DLVRIT_ROUTE_TIKTOK=

# -----------------------------------------------------------------------------
# SEO Site
# -----------------------------------------------------------------------------
DOMAIN=defycard.com

# -----------------------------------------------------------------------------
# Google Analytics 4 (GA4)
# Astro PUBLIC_* prefix exposes the value at build time. Set to "off" to
# disable analytics (e.g. for a staging build). Default fallback in
# BaseLayout.astro is the production property G-JLRZD59902.
# -----------------------------------------------------------------------------
PUBLIC_GA_MEASUREMENT_ID=G-JLRZD59902

# -----------------------------------------------------------------------------
# Affiliate Links — referral URLs for CTAs
# -----------------------------------------------------------------------------
ETHERFI_REF_URL=
# Astro requires PUBLIC_* prefix to expose env vars at build time. Keep the
# two values in sync — deploy.sh prefers PUBLIC_* over the bare name.
PUBLIC_ETHERFI_REF_URL=
G2A_REF_URL=
KINGUIN_REF_URL=
NORDVPN_REF_URL=
CRYPTOCOM_REF_URL=
PLASMA_REF_URL=

# -----------------------------------------------------------------------------
# Telegram alerts (publish failures, schedule misses, hook blocks)
# -----------------------------------------------------------------------------
TG_BOT_TOKEN=
TG_CHAT_ID=

# -----------------------------------------------------------------------------
# Anthropic API (pseo-generate.py + video-generator)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
WRITER_MODEL=claude-haiku-4-5-20251001

# -----------------------------------------------------------------------------
# Unsplash (article hero + inline images — write-article skill §3)
# https://unsplash.com/oauth/applications  →  Access Key (NOT secret key)
# -----------------------------------------------------------------------------
UNSPLASH_ACCESS_KEY=

# -----------------------------------------------------------------------------
# pSEO probabilistic gate (write-article skill §4)
#
# IMPORTANT — the gate probability MUST be tuned to the daily cap in
# config/pseo-rate.txt. Per skill §4.3 expected interval = cooldown + 1/p:
#   cap=10  → set PSEO_GATE_PROBABILITY=0.10  (interval ~36 min)
#   cap=30  → set PSEO_GATE_PROBABILITY=0.30  (interval ~9.3 min, 30/day)
#   cap=50  → set PSEO_GATE_PROBABILITY=0.50  (interval ~8 min)
# Mismatch causes early cap exhaustion or under-utilisation of the day.
# -----------------------------------------------------------------------------
PSEO_GATE_PROBABILITY=0.10
# Phase gate: do NOT bump to 0.30 + cap=30 until ≥80% of Phase 1 articles
# are indexed in GSC AND "Discovered - not indexed" <10% for 30 days.
PSEO_COOLDOWN_MINUTES=30
# ↑ default p=0.10 paired with config/pseo-rate.txt=10 (Phase 1).
# Bump BOTH together when scaling: cap=30 → p=0.30 (Phase 2a), cap=50 → p=0.50.

# Google Analytics 4 — numeric property id for the Data API
GA4_PROPERTY_ID=
