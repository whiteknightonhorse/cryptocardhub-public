---
/**
 * BucketSiblings — auto-generated bento grid.
 *
 * Matches Stitch article "More from Credit Cards" bento layout:
 *   On desktop:  [LARGE CARD spans 2 cols × 2 rows]  [small]  [small]  [WIDE spans 2 cols]
 *   On tablet:   2-col grid, all equal
 *   On mobile:   1-col stack
 *
 * Picks the N topically closest pages (Jaccard over keyword tokens, all buckets)
 * via lib/related.mjs; same-bucket seeded shuffle fills any shortfall.
 */
import { getCollection } from 'astro:content';
import { pickRelated } from '../lib/related.mjs';

export interface Props {
  bucket: string;
  excludeSlug: string;
  count?: number;
  heading?: string;
}

const {
  bucket,
  excludeSlug,
  count = 5,
  heading,
} = Astro.props;

const bucketChip: Record<string, string> = {
  hub: 'GUIDE',
  compare: 'COMPARE',
  reviews: 'REVIEW',
  geo: 'REGION',
  tools: 'TOOL',
  'how-to': 'GUIDE',
  for: 'USE CASE',
  learn: 'LEARN',
  help: 'HELP',
  news: 'NEWS',
  faq: 'FAQ',
};

const all = await getCollection('pseo');
const current = all.find((e) => e.data.bucket === bucket && e.data.slug === excludeSlug);
const picked = current ? pickRelated(current, all, count) : [];
const headingText = heading || 'Related reading';
---
{picked.length > 0 && (
  <section class="bucket-siblings" aria-labelledby="siblings-heading">
    <h2 id="siblings-heading">{headingText}</h2>
    <div class="bento-grid">
      {picked.map((e, i) => (
        <a class="bento-card" href={`/${e.data.bucket}/${e.data.slug}/`}>
          <div>
            <span class="bento-label">{bucketChip[e.data.bucket] || e.data.bucket.toUpperCase()}</span>
            <h3 class="bento-h3">{e.data.h1}</h3>
            {i === 0 && e.data.description && (
              <p class="bento-desc">{e.data.description.slice(0, 130)}…</p>
            )}
          </div>
          <span class="material-symbols-outlined" aria-hidden="true" style="color: var(--outline); align-self: flex-end;">arrow_forward</span>
        </a>
      ))}
    </div>
  </section>
)}
