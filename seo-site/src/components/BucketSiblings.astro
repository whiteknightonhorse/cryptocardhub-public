---
/**
 * BucketSiblings — auto-generated bento grid.
 *
 * Matches Stitch article "More from Credit Cards" bento layout:
 *   On desktop:  [LARGE CARD spans 2 cols × 2 rows]  [small]  [small]  [WIDE spans 2 cols]
 *   On tablet:   2-col grid, all equal
 *   On mobile:   1-col stack
 *
 * Picks N random siblings from same bucket via deterministic shuffle seeded
 * by the current entry's slug — link graph stable across builds.
 */
import { getCollection } from 'astro:content';

export interface Props {
  bucket: string;
  excludeSlug: string;
  count?: number;
  heading?: string;
}

const {
  bucket,
  excludeSlug,
  count = 5,
  heading,
} = Astro.props;

const bucketDisplayName: Record<string, string> = {
  hub: 'Guides',
  compare: 'Comparisons',
  reviews: 'Card Reviews',
  geo: 'Country Guides',
  tools: 'Tools',
  'how-to': 'How-To',
  for: 'Use Cases',
  learn: 'Education',
  help: 'Troubleshooting',
  news: 'News',
  faq: 'FAQ',
};

const bucketChip: Record<string, string> = {
  hub: 'GUIDE',
  compare: 'COMPARE',
  reviews: 'REVIEW',
  geo: 'REGION',
  tools: 'TOOL',
  'how-to': 'GUIDE',
  for: 'USE CASE',
  learn: 'LEARN',
  help: 'HELP',
  news: 'NEWS',
  faq: 'FAQ',
};

function seededShuffle<T>(arr: T[], seed: string): T[] {
  let s = 0;
  for (const c of seed) s = (s * 31 + c.charCodeAt(0)) >>> 0;
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    s = (s * 1103515245 + 12345) >>> 0;
    const j = s % (i + 1);
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

const siblings = (await getCollection('pseo'))
  .filter((e) => e.data.bucket === bucket && e.data.slug !== excludeSlug);

const picked = seededShuffle(siblings, excludeSlug).slice(0, count);
const headingText = heading || `More from ${bucketDisplayName[bucket] || bucket}`;
---
{picked.length > 0 && (
  <section class="bucket-siblings" aria-labelledby="siblings-heading">
    <h2 id="siblings-heading">{headingText}</h2>
    <div class="bento-grid">
      {picked.map((e, i) => (
        <a class="bento-card" href={`/${e.data.bucket}/${e.data.slug}/`}>
          <div>
            <span class="bento-label">{bucketChip[e.data.bucket] || e.data.bucket.toUpperCase()}</span>
            <h3 class="bento-h3">{e.data.h1}</h3>
            {i === 0 && e.data.description && (
              <p class="bento-desc">{e.data.description.slice(0, 130)}…</p>
            )}
          </div>
          <span class="material-symbols-outlined" aria-hidden="true" style="color: var(--outline); align-self: flex-end;">arrow_forward</span>
        </a>
      ))}
    </div>
  </section>
)}
