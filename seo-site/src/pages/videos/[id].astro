---
/**
 * /videos/<id>/ — single-video page.
 *
 * Renders YouTube iframe (privacy-enhanced youtube-nocookie.com) plus a
 * VideoObject JSON-LD block so Google can index the page as a video result.
 * The page is also surfaced in sitemap-videos.xml (built from the same
 * content collection) — see scripts/build-video-sitemap.py.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('videos');
  return entries.map((entry) => ({
    params: { id: entry.data.id },
    props: { video: entry.data },
  }));
}

const { video } = Astro.props;
const siteOrigin = import.meta.env.PUBLIC_SITE_URL || 'https://defycard.com';
const pageUrl = `${siteOrigin}/videos/${video.id}/`;
const breadcrumbs = [
  { name: 'Home', url: `${siteOrigin}/` },
  { name: 'Videos', url: `${siteOrigin}/videos/` },
  { name: video.title, url: pageUrl },
];

const schemaVideo = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: video.title,
  description: video.description,
  thumbnailUrl: [video.thumbnail_url],
  uploadDate: video.published_at,
  contentUrl: video.youtube_url,
  embedUrl: video.embed_url,
  ...(video.duration_s ? { duration: `PT${Math.round(video.duration_s)}S` } : {}),
  publisher: {
    '@type': 'Organization',
    name: 'DefyCard',
    logo: {
      '@type': 'ImageObject',
      url: `${siteOrigin}/logo.png`,
    },
  },
};

function shortDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric', month: 'short', day: 'numeric',
  });
}
---
<BaseLayout
  title={`${video.title} — DefyCard`}
  description={video.description}
  activeNav="cards"
  breadcrumbs={breadcrumbs}
>
  <article class="video-page">
    <header class="video-page-header">
      <p class="video-page-meta">
        <a href="/videos/">← All videos</a>
        <span aria-hidden="true">·</span>
        <time datetime={video.published_at}>{shortDate(video.published_at)}</time>
        <span aria-hidden="true">·</span>
        <span>{video.topic_category}</span>
      </p>
      <h1>{video.title}</h1>
    </header>

    <div class="video-embed-wrap">
      <iframe
        src={`${video.embed_url}?rel=0&modestbranding=1`}
        title={video.title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      />
    </div>

    {video.body && (
      <section class="video-body">
        <h2>Full transcript</h2>
        <p>{video.body}</p>
      </section>
    )}

    {video.target_pseo_slug && (
      <p class="video-related">
        Related deep-dive: <a href={`/${video.target_pseo_slug}/`}>{video.target_pseo_slug}</a>
      </p>
    )}

    <p class="video-watch-elsewhere">
      Watch on <a href={video.youtube_url} target="_blank" rel="noopener">YouTube</a>.
    </p>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(schemaVideo)} />
</BaseLayout>

<style>
  .video-page {
    padding-top: 8px;
    max-width: 880px;
    margin: 0 auto;
  }
  .video-page-header h1 {
    margin: 8px 0 16px;
    font-size: 1.6rem;
    line-height: 1.25;
  }
  .video-page-meta {
    margin: 0;
    font-size: 0.88rem;
    color: var(--on-surface-variant);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .video-page-meta a {
    color: var(--primary);
  }
  .video-embed-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin: 16px 0 24px;
  }
  .video-embed-wrap iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-body {
    margin: 24px 0;
  }
  .video-body h2 {
    font-size: 1.1rem;
    margin: 0 0 8px;
  }
  .video-body p {
    margin: 0;
    line-height: 1.6;
    color: var(--on-surface-variant);
  }
  .video-related {
    margin: 16px 0;
    padding: 12px 16px;
    background: var(--surface-container-low);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-sm);
  }
  .video-watch-elsewhere {
    margin-top: 24px;
    color: var(--on-surface-variant);
  }
</style>
