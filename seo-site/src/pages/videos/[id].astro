---
/**
 * /videos/<id>/ — single-video page.
 *
 * Renders YouTube iframe (privacy-enhanced youtube-nocookie.com) plus a
 * VideoObject JSON-LD block so Google can index the page as a video result.
 *
 * Index law (CCH-SEO-32, heroVideoFor in lib/videos.mjs): the HERO video of an
 * article (the one the article embeds) canonicalises to that article and is
 * not itself in sitemap-0.xml; scripts/build-video-sitemap.py lists the
 * article URL in sitemap-videos.xml for it. Every other video page is
 * `noindex, follow` with a self-canonical. All stay 200 and listed on /videos/.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { heroVideoFor } from '../../lib/videos.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('videos');
  return entries.map((entry) => ({
    params: { id: entry.data.id },
    props: { video: entry.data },
  }));
}

const { video } = Astro.props;
const pseoPages = await getCollection('pseo');
const guide = video.target_pseo_slug
  ? pseoPages.find((p) => `${p.data.bucket}/${p.data.slug}` === video.target_pseo_slug)
  : undefined;
const description = (video.description || '').trim()
  || (guide
    ? `${video.title}. Short video for: ${guide.data.title}.`
    : `${video.title}. A DefyCard short video on crypto cards.`);
const ogImage = video.thumbnail_url || `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`;
const siteOrigin = import.meta.env.PUBLIC_SITE_URL || 'https://defycard.com';
const pageUrl = `${siteOrigin}/videos/${video.id}/`;
const allVideos = (await getCollection('videos')).map((v) => v.data);
const isHero = !!guide && heroVideoFor(video.target_pseo_slug, allVideos)?.id === video.id;
const breadcrumbs = [
  { name: 'Home', url: `${siteOrigin}/` },
  { name: 'Videos', url: `${siteOrigin}/videos/` },
  { name: video.title, url: pageUrl },
];

const schemaVideo = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: video.title,
  description,
  thumbnailUrl: [ogImage],
  uploadDate: video.published_at,
  contentUrl: video.youtube_url,
  embedUrl: video.embed_url,
  ...(video.duration_s ? { duration: `PT${Math.round(video.duration_s)}S` } : {}),
  publisher: {
    '@type': 'Organization',
    name: 'DefyCard',
    logo: {
      '@type': 'ImageObject',
      url: `${siteOrigin}/logo.png`,
    },
  },
};

function shortDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric', month: 'short', day: 'numeric',
  });
}
---
<BaseLayout
  title={`${video.title} — DefyCard`}
  description={description}
  ogImage={ogImage}
  activeNav="cards"
  breadcrumbs={breadcrumbs}
  canonical={isHero ? `${siteOrigin}/${video.target_pseo_slug}/` : pageUrl}
  noindex={!isHero}
>
  <article class="video-page">
    <header class="video-page-header">
      <p class="video-page-meta">
        <a href="/videos/">← All videos</a>
        <span aria-hidden="true">·</span>
        <time datetime={video.published_at}>{shortDate(video.published_at)}</time>
        <span aria-hidden="true">·</span>
        <span>{video.topic_category}</span>
      </p>
      <h1>{video.title}</h1>
    </header>

    <div class="video-embed-wrap">
      <iframe
        src={`${video.embed_url}?rel=0&modestbranding=1`}
        title={video.title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      />
    </div>

    {video.body && (
      <section class="video-body">
        <h2>Full transcript</h2>
        <p>{video.body}</p>
      </section>
    )}

    {guide && (
      <p class="video-related">
        Full guide: <a href={`/${video.target_pseo_slug}/`}>{guide.data.title}</a>
      </p>
    )}

    <p class="video-watch-elsewhere">
      Watch on <a href={video.youtube_url} target="_blank" rel="noopener">YouTube</a>.
    </p>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(schemaVideo)} />
</BaseLayout>

<style>
  .video-page {
    padding-top: 8px;
    max-width: 880px;
    margin: 0 auto;
  }
  .video-page-header h1 {
    margin: 8px 0 16px;
    font-size: 1.6rem;
    line-height: 1.25;
  }
  .video-page-meta {
    margin: 0;
    font-size: 0.88rem;
    color: var(--on-surface-variant);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .video-page-meta a {
    color: var(--primary);
  }
  .video-embed-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin: 16px 0 24px;
  }
  .video-embed-wrap iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-body {
    margin: 24px 0;
  }
  .video-body h2 {
    font-size: 1.1rem;
    margin: 0 0 8px;
  }
  .video-body p {
    margin: 0;
    line-height: 1.6;
    color: var(--on-surface-variant);
  }
  .video-related {
    margin: 16px 0;
    padding: 12px 16px;
    background: var(--surface-container-low);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-sm);
  }
  .video-watch-elsewhere {
    margin-top: 24px;
    color: var(--on-surface-variant);
  }
</style>
