---
/**
 * Homepage — translates Stitch homepage design 1:1 into Astro.
 *
 * Sections (top to bottom):
 *  - Hero: H1 + lead + featured ether.fi card row (logo + cashback badge + CTA)
 *  - Explore DefyCard: 9-tile bucket grid (Material Symbols icons)
 *  - Latest Reviews & Analysis: 4-card grid sourced from pseo collection
 *  - About DefyCard: centered card
 *
 * Hand-curated — NOT generated by pseo-generate.py.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import LatestPosts from '../components/LatestPosts.astro';
import heroVariants from '../data/hero-variants.json';

const now = new Date();
const monthYear = now.toLocaleString('en-US', { month: 'long', year: 'numeric' });
const affiliateUrl = import.meta.env.PUBLIC_ETHERFI_REF_URL || 'https://www.ether.fi/@defycard';

// Monthly hero rotation — pick deterministically by (year*12 + monthIndex0) so:
//   1. Same year+month always renders the same variant (idempotent build).
//   2. Each new calendar month picks the next slot (fresh prose for SEO + repeat visitors).
//   3. Rotation period = variants.length months (currently 20 months ≈ 1.67 years before any repeat).
// Refresh trigger: scripts/monthly-rebuild.sh fires via cron at 00:05 ET on the 1st of each month
// and runs `pnpm build && bash scripts/deploy.sh`. See seo2026/SKILL.md §12.4 for the contract.
const heroIdx = (now.getFullYear() * 12 + now.getMonth()) % heroVariants.variants.length;
const heroLead = heroVariants.variants[heroIdx];

const buckets = [
  { href: '/hub/best-crypto-card-2026/', icon: 'workspace_premium', label: 'Best crypto cards 2026' },
  { href: '/compare/', icon: 'compare_arrows', label: 'Compare cards' },
  { href: '/reviews/', icon: 'rate_review', label: 'Card reviews' },
  { href: '/how-to/', icon: 'menu_book', label: 'How-to guides' },
  { href: '/for/', icon: 'cases', label: 'Use cases' },
  { href: '/tools/', icon: 'calculate', label: 'Calculators' },
  { href: '/learn/', icon: 'school', label: 'Learn' },
  { href: '/help/', icon: 'build', label: 'Troubleshooting' },
  { href: '/faq/', icon: 'help_outline', label: 'FAQ' },
];
---
<BaseLayout
  title={`DefyCard — best crypto cards (${monthYear})`}
  description="Independent reviews and side-by-side comparisons of crypto debit and credit cards. Cashback, fees, availability, and yield-while-spending verified for 2026."
  activeNav="cards"
>
  <!-- 3. HERO -->
  <section class="homepage-hero">
    <div class="homepage-hero-text">
      <h1>Best crypto cards — {monthYear}</h1>
      <p class="lead">{heroLead}</p>
    </div>

    <article class="featured-card hero-card-v2">
      <div class="featured-card-visual" aria-hidden="true">
        <svg viewBox="0 0 380 240" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="ether.fi Cash Visa card">
          <defs>
            <linearGradient id="card-bg" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="var(--color-indigo)" />
              <stop offset="55%" stop-color="var(--color-purple)" />
              <stop offset="100%" stop-color="#1a1530" />
            </linearGradient>
            <linearGradient id="card-shine" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="rgba(255,255,255,0.18)" />
              <stop offset="50%" stop-color="rgba(255,255,255,0.04)" />
              <stop offset="100%" stop-color="rgba(255,255,255,0)" />
            </linearGradient>
            <linearGradient id="chip-gold" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#d4a85a" />
              <stop offset="100%" stop-color="#8e6d2a" />
            </linearGradient>
          </defs>
          <!-- Body -->
          <rect x="2" y="2" width="376" height="236" rx="20" ry="20" fill="url(#card-bg)" />
          <!-- Glossy highlight -->
          <rect x="2" y="2" width="376" height="236" rx="20" ry="20" fill="url(#card-shine)" />
          <!-- Subtle line accent -->
          <path d="M 240 0 Q 320 80 380 140 L 380 240 L 280 240 Z" fill="rgba(255,255,255,0.04)" />
          <!-- Chip -->
          <rect x="28" y="78" width="48" height="38" rx="6" ry="6" fill="url(#chip-gold)" />
          <line x1="40" y1="78" x2="40" y2="116" stroke="rgba(0,0,0,0.35)" stroke-width="1" />
          <line x1="52" y1="78" x2="52" y2="116" stroke="rgba(0,0,0,0.35)" stroke-width="1" />
          <line x1="64" y1="78" x2="64" y2="116" stroke="rgba(0,0,0,0.35)" stroke-width="1" />
          <line x1="28" y1="92" x2="76" y2="92" stroke="rgba(0,0,0,0.35)" stroke-width="1" />
          <line x1="28" y1="104" x2="76" y2="104" stroke="rgba(0,0,0,0.35)" stroke-width="1" />
          <!-- Contactless waves -->
          <g fill="none" stroke="rgba(255,255,255,0.85)" stroke-width="2" stroke-linecap="round" transform="translate(94 78)">
            <path d="M 0 0 Q 8 14 0 28" />
            <path d="M 8 -4 Q 20 14 8 32" />
            <path d="M 16 -8 Q 32 14 16 36" />
          </g>
          <!-- ETH glyph top right -->
          <g transform="translate(330 32)" fill="rgba(255,255,255,0.92)">
            <polygon points="0,-22 14,4 0,-2 -14,4" />
            <polygon points="0,22 14,8 0,14 -14,8" />
          </g>
          <!-- Card number -->
          <text x="28" y="165" font-family="ui-monospace, 'SF Mono', monospace" font-size="22" fill="#ffffff" letter-spacing="2">
            •••• •••• •••• 3142
          </text>
          <!-- Brand bottom-left -->
          <text x="28" y="210" font-family="var(--font-display-alt), system-ui" font-size="14" font-weight="600" fill="#ffffff" letter-spacing="0.5">
            ether.fi cash
          </text>
          <text x="28" y="226" font-family="var(--font-display-alt), system-ui" font-size="9" font-weight="500" fill="rgba(255,255,255,0.6)" letter-spacing="1.5">
            DEBIT · DEFI-NATIVE
          </text>
          <!-- VISA bottom-right -->
          <text x="352" y="218" font-family="Arial, sans-serif" font-size="22" font-weight="900" fill="#ffffff" font-style="italic" text-anchor="end" letter-spacing="0.5">
            VISA
          </text>
        </svg>
      </div>

      <div class="featured-card-content">
        <h3>ether.fi Cash</h3>
        <p class="featured-tagline">DeFi-native debit card — spend while your ETH keeps earning yield.</p>
        <ul class="featured-perks">
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">payments</span>
            <span><strong>Up to 3% cashback</strong> in ETH on every swipe</span>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">verified_user</span>
            <span><strong>Self-custody</strong> — your keys, your coins, always</span>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">public</span>
            <span><strong>76 countries</strong> · 0% FX on USD/EUR</span>
          </li>
        </ul>
        <a class="featured-cta featured-cta-large" href={affiliateUrl} rel="sponsored noopener" target="_blank">
          Get the card
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
    </article>
  </section>

  <!-- 4. EXPLORE DEFYCARD (bucket tiles) -->
  <section style="margin-top: 56px;">
    <h2 class="section-heading">Explore DefyCard</h2>
    <ul class="bucket-tiles">
      {buckets.map((b) => (
        <li>
          <a class="bucket-tile" href={b.href}>
            <span class="bucket-tile-icon">
              <span class="material-symbols-outlined" aria-hidden="true">{b.icon}</span>
            </span>
            <span class="bucket-tile-label">{b.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- 5. LATEST REVIEWS & ANALYSIS -->
  <section style="margin-top: 56px;" class="latest-posts">
    <LatestPosts count={4} heading="Latest Reviews & Analysis" />
    <div class="view-all-wrap">
      <a class="view-all-link" href="/articles/">
        View all articles
        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </a>
    </div>
  </section>

  <!-- 6. ABOUT DEFYCARD -->
  <section style="margin-top: 56px;" class="about-card">
    <h2>About DefyCard</h2>
    <p>
      DefyCard is an independent comparison platform dedicated to the crypto debit and credit
      card ecosystem. We track 11 cards across 5 global regions, updating our database weekly.
      Our editorial team operates with strict independence, prioritizing objective analysis
      over affiliate partnerships.
    </p>
  </section>
</BaseLayout>
