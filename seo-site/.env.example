# Astro env (PUBLIC_* are exposed to client; others are server-only at build)

# Affiliate referral resolved at build time, never hardcoded in components
PUBLIC_ETHERFI_REF_URL=https://www.ether.fi/@defycard
PUBLIC_ETHERFI_REF_URL_SHORT=https://www.ether.fi/@defy

# Canonical site origin used for sitemaps + canonical tags
PUBLIC_SITE_URL=https://defycard.com
